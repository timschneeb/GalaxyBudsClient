<Project>
    <PropertyGroup>
        <!-- App properties -->
        <AssemblyVersion>5.2.1.0</AssemblyVersion>
        <Version>5.2.1.0</Version>
        <!-- ApplicationVersion must be an integer version code required for Android -->
        <ApplicationVersion>$(Version.ToString().Replace('.', ''))</ApplicationVersion>
        <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Global dependency versions -->
        <AvaloniaVersion>12.1.6</AvaloniaVersion>
        <!-- DataGrid releases lag behind core Avalonia; pin separately -->
        <AvaloniaDataGridVersion>12.1.2</AvaloniaDataGridVersion>
    </PropertyGroup>
</Project>
