    <sys:String x:Key="devsel_invalid_selection">請選擇一個有效的裝置</sys:String>
    <sys:String x:Key="devsel_winrt_title">使用更進階的藍牙後端</sys:String>
    <sys:String x:Key="devsel_winrt">穩定性會提升許多，但某些裝置的藍牙可能會不支援</sys:String>

