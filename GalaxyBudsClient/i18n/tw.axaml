    <!--Advanced page-->
    <sys:String x:Key="adv_header">耳機設定</sys:String>
    <sys:String x:Key="adv_seamless">流暢耳機連接</sys:String>
    <sys:String x:Key="adv_seamless_desc">無須中斷連接耳機或開啟配對模式即可快速切換附近裝置。</sys:String>
    <sys:String x:Key="adv_resume_playback">入耳偵測</sys:String>
    <sys:String x:Key="adv_resume_playback_desc">配戴時自動播放/暫停媒體（僅限桌面）</sys:String>
    <sys:String x:Key="adv_sidetone">通話期間使用環境音效</sys:String>
    <sys:String x:Key="adv_sidetone_desc">通話期間清楚聽見自己的聲音。如此可讓長時間通話更加舒適，並有助您避免不慎提高音量。</sys:String>
    <sys:String x:Key="adv_callpath">通話入耳偵測</sys:String>
    <sys:String x:Key="adv_callpath_desc">佩戴耳機時，透過耳機播放通話；未佩戴時，則透過電腦喇叭播放</sys:String>
    <sys:String x:Key="adv_extra_clear_call">增強通話音質</sys:String>
    <sys:String x:Key="adv_extra_clear_call_desc">提升通話清晰度。在吵雜環境中使用耳機通話時特別有用，但會增加電池耗電量。</sys:String>
    <sys:String x:Key="adv_passthrough">用環境聲緩解壓力</sys:String>
    <sys:String x:Key="adv_passthrough_desc">當您不使用主動降噪時，這可以防止悶熱或壓迫感</sys:String>
    <sys:String x:Key="adv_gaming_mode">遊戲模式</sys:String>
    <sys:String x:Key="adv_gaming_mode_desc">有效改善音訊延遲情況，享受逼真且同步的遊戲音效。（僅支援 Samsung 裝置）</sys:String>
    <sys:String x:Key="adv_hotkey">鍵盤快捷鍵</sys:String>
    <sys:String x:Key="adv_hotkey_desc">自訂鍵盤快捷鍵以遠端控制您的耳機</sys:String>
    <sys:String x:Key="adv_bixby_remap">重新定義 Bixby 喚醒</sys:String>
    <sys:String x:Key="adv_bixby_remap_desc">自訂當您說出「Hay Bixby！」時的動作</sys:String>

    <!--Remap bixby wakeup-->
    <sys:String x:Key="bixby_remap_enable">開啟 Bixby 喚醒</sys:String>
    <sys:String x:Key="bixby_remap_enable_desc">在您的三星手機上開啟 Bixby 或在喚醒時在此電腦上執行自訂動作</sys:String>
    <sys:String x:Key="bixby_remap_lang">Bixby 喚醒語言</sys:String>
    <sys:String x:Key="bixby_remap_lang_desc">變更喚醒語詞所使用的語言</sys:String>
    <sys:String x:Key="bixby_remap_action">自訂喚醒動作</sys:String>
    <sys:String x:Key="bixby_remap_action_desc">設定在此裝置上喚醒 Bixby 時要執行的動作</sys:String>
    <sys:String x:Key="bixby_remap_note">說出「Hey Bixby！」以開啟此功能。開啟用語可能因某些語言設定而異。

重新定義設定僅在此裝置上有效。如果您將耳機連接到三星裝置，語音喚醒將正常開啟 Bixby。在此裝置和非三星手機的其他裝置上，此功能不會觸發任何動作。</sys:String>

    
