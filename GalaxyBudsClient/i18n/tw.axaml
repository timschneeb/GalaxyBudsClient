    <sys:String x:Key="nc_voicedetect">語音檢測</sys:String>
    <sys:String x:Key="nc_voicedetect_description">偵測到您的聲音時，系統將自動開啟環境音效並降低媒體音量以供您輕鬆對話</sys:String>
    <sys:String x:Key="nc_voicedetect_timeout">對話超時</sys:String>
