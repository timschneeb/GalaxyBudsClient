    <!-- Usage-/metering reports -->
    <sys:String x:Key="usage_reports_header">تقارير الاستخدام</sys:String>
    <sys:String x:Key="usage_reports_hint">تتم جمع هذه التقارير بواسطة السماعات نفسها. يتم عرض البيانات كما هي وقد تكون غير دقيقة. يقوم تطبيق Wearable الرسمي عادةً بإعادة ضبط معظم العدادات بشكل دوري ثم إرسال البيانات المجمعة إلى Samsung ما لم تكن قد رفضت الموافقة على جمع البيانات في تطبيقهم. بعض العدادات، مثل دورات الشحن، لا يتم إعادة ضبطها.</sys:String>
    <sys:String x:Key="usage_reports_usage">تقرير الاستخدام</sys:String>
    <sys:String x:Key="usage_reports_metering">تقرير القياس</sys:String>
    <sys:String x:Key="milliamp_hours_unit">{0} مللي أمبير/ساعة</sys:String>
    <sys:String x:Key="metering_total_batt_capacity">إجمالي سعة البطارية</sys:String>
    <sys:String x:Key="metering_a2dp_time">وقت تشغيل الموسيقى (A2DP)</sys:String>
    <sys:String x:Key="metering_esco_time">وقت استخدام المكالمات (eSCO)</sys:String>

    <!-- Battery history -->
    <sys:String x:Key="batt_hist_hint">يمكن لهذا التطبيق جمع مستويات البطارية وبيانات الاستخدام الأساسية بمرور الوقت، مما يتيح لك تحليل استهلاك البطارية. لا يمكن جمع البيانات إلا أثناء عمل هذا التطبيق في الخلفية وتوصيل سماعاتك بهذا الجهاز.</sys:String>
    <sys:String x:Key="batt_hist_no_data_title">بيانات غير كافية</sys:String>
    <sys:String x:Key="batt_hist_no_data">يرجى العودة في وقت لاحق عندما يتم جمع بيانات كافية أو اضبط النطاق الزمني المعروض.</sys:String>
    <sys:String x:Key="batt_hist_y_axis">الشحن (%)</sys:String>
    <sys:String x:Key="batt_hist_last_hour">الساعة الأخيرة</sys:String>
    <sys:String x:Key="batt_hist_last_6_hours">آخر 6 ساعات</sys:String>
    <sys:String x:Key="batt_hist_last_12_hours">آخر 12 ساعة</sys:String>
    <sys:String x:Key="batt_hist_last_24_hours">آخر 24 ساعة</sys:String>
    <sys:String x:Key="batt_hist_last_3_days">آخر 3 أيام</sys:String>
    <sys:String x:Key="batt_hist_last_7_days">آخر 7 أيام</sys:String>
    <sys:String x:Key="batt_hist_overlay_none">بدون تراكب</sys:String>
    <sys:String x:Key="batt_hist_overlay_noise_controls">عناصر التحكم بالضوضاء</sys:String>
    <sys:String x:Key="batt_hist_overlay_wearing">حالة الارتداء</sys:String>
    <sys:String x:Key="batt_hist_overlay_host_device">الجهاز المضيف</sys:String>
    <sys:String x:Key="batt_hist_overlay_legend">{0} (تراكب)</sys:String>
    <sys:String x:Key="batt_hist_tools_pan_and_zoom">السحب والتقريب</sys:String>
    <sys:String x:Key="batt_hist_tools_measure_time">قياس الوقت</sys:String>
    <sys:String x:Key="batt_hist_tools_measure_battery">قياس المستوى</sys:String>
    <sys:String x:Key="batt_hist_show_legend">إظهار مفتاح الرسم البياني</sys:String>
    <sys:String x:Key="batt_hist_measure_difference_display">الفرق: {0}</sys:String>
    <sys:String x:Key="batt_hist_measure_timespan_display">النطاق الزمني: {0}</sys:String>
    <sys:String x:Key="batt_hist_measure_timespan_unit_long">d' يوم (أيام)، 'hh'س:'mm'د:'ss'ث'</sys:String> <!-- This is a time span format string. It produces a string like: 2 day(s), 03h:10:01 -->
    <sys:String x:Key="batt_hist_time_span_tip_title">النطاق الزمني</sys:String>
    <sys:String x:Key="batt_hist_control_tip_title">عناصر تحكم الماوس</sys:String>
    <sys:String x:Key="batt_hist_control_tip">اسحب اللوحة للتحرك حول الرسم البياني.

قم بالتمرير للتقريب/الابتعاد أفقياً ورأسياً.

حرك الماوس فوق المحور X أو Y وقم بالتمرير للتقريب/الابتعاد أفقياً أو رأسياً فقط. التمرير فوق المحور X (الوقت) سيقوم بتوسيعه أو ضغطه، على سبيل المثال.</sys:String>
    <sys:String x:Key="batt_hist_overlay_tip_title">التراكبات</sys:String>
    <sys:String x:Key="batt_hist_overlay_tip">يمكنك استخدام التراكبات لإضافة سياق إضافي إلى الرسم البياني.

التحكم بالضوضاء: يوضح ما إذا كانت عناصر التحكم بالضوضاء مفعّلة أم معطلة.

حالة الارتداء: يوضح ما إذا كانت السماعات ملبوسة أم لا.

الجهاز المضيف: يوضح أي من السماعات تستضيف اتصال البلوتوث بجهاز الكمبيوتر.

قد تكون بيانات التراكب صعبة الفهم عند عرض نطاقات زمنية كبيرة. حرك الماوس فوق المحور X وقم بالتمرير للأعلى للتقريب إلى نطاق زمني معين تريد فحصه للحصول على نظرة أفقية أفضل.</sys:String>
    <sys:String x:Key="batt_hist_tools_tip_title">الأدوات</sys:String>
    <sys:String x:Key="batt_hist_tools_tip">السحب والتقريب: الوضع الافتراضي. التنسيق والتنقل في الرسم البياني بالسحب والتكبير/التصغير.

قياس الوقت: حدد نطاقًا أفقيًا لقياس الوقت المنقضي بين بداية التحديد ونهايته.

قياس المستوى: حدد نطاقًا رأسيًا لقياس الفرق في مستوى البطارية بين بداية التحديد ونهايته.</sys:String>

