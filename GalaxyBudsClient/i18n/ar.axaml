    <sys:String x:Key="coredump_dl_save_success_title">تم حفظ ملفات التفريغ بنجاح</sys:String>
    <sys:String x:Key="coredump_dl_save_success">تم كتابة {0} من ملفات التفريغ إلى '{1}'</sys:String>
