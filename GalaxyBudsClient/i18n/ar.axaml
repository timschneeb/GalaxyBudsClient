    <sys:String x:Key="hidden_mode_target">الجهاز المستهدف: السماعة {0}</sys:String> <!-- {0} = Left or Right -->
    <sys:String x:Key="hidden_mode_target_l_desc">لتعديل سماعة الأذن اليسرى، ضع السماعة اليمنى في العلبة وأغلقها.</sys:String>
